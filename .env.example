# Sibyl Relay configuration. Copy to .env and fill in. Never commit real secrets.

# ---- Sibyl Memory (mandatory foundation) ----
# Point at the same SQLite database Sibyl uses. Omit to use the in-memory store.
# SIBYL_RELAY_DB=/Users/you/.sibyl-memory/memory.db

# ---- Base stack (onchain USDC settlement) ----
# With only the RPC set, Base runs in dry-run mode: it validates and gas-estimates
# a real USDC transfer against the live chain but does not broadcast.
BASE_CHAIN_ID=84532                       # 84532 = Base Sepolia, 8453 = Base mainnet
BASE_RPC_URL=https://sepolia.base.org
# BASE_USDC_ADDRESS=                       # defaults to Circle's USDC for the chain
# Set a funded key to move from dry-run to LIVE broadcast. Testnet key only for demos.
# BASE_PRIVATE_KEY=0x...

# ---- Virtuals stack (ACP agent delegation) ----
# VIRTUALS_AGENT_WALLET_ADDRESS=0x...      # your ACP buyer agent wallet
# VIRTUALS_WHITELISTED_WALLET_PRIVATE_KEY=0x...
# VIRTUALS_CHAIN_ID=84532
# VIRTUALS_EVALUATOR_ADDRESS=0x...          # optional third-party evaluator

# ---- Dashboard server ----
# HOST=127.0.0.1
# PORT=8000
