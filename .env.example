# Praetor configuration. Copy to .env and fill in.
# Never commit real secrets. .env is git-ignored.

# ---- Sibyl Memory (mandatory foundation) ----
# Path to the SQLite database Sibyl created via `sibyl init`. Omit to run
# against an ephemeral in-memory store (state is lost on restart).
# PRAETOR_DB=/Users/you/.sibyl-memory/memory.db

# ---- Operator security ----
# Required on every write endpoint (POST /api/workers, DELETE, POST /api/jobs).
# Generate: openssl rand -hex 32
# The dashboard prompts for this once and remembers it in localStorage.
# PRAETOR_ADMIN_TOKEN=

# ---- Base stack (onchain USDC settlement) ----
# 8453 = mainnet, 84532 = Sepolia testnet.
BASE_CHAIN_ID=8453
BASE_RPC_URL=https://mainnet.base.org
# Circle's USDC contract is used by default for each chain; override only for
# custom deployments.
# BASE_USDC_ADDRESS=
# Signer private key. Without it, Base runs in DRY-RUN — real chain validation
# and gas estimation, no broadcast. With it, jobs settle real USDC on-chain.
# On mainnet this wallet MUST hold ETH (for gas) + USDC (for payouts).
# BASE_PRIVATE_KEY=

# The DEMO_WORKER_WALLET below is only used by the demo-mode seed and is
# ignored in operator mode. Leave commented for production.
# DEMO_WORKER_WALLET=

# ---- Virtuals stack (ACP agent delegation) ----
# Register your agent at https://app.virtuals.io (ACP / Agentic Commerce).
# Registration deploys an on-chain smart account and gives you:
#   VIRTUALS_AGENT_WALLET_ADDRESS  – the deployed agent account address
#   VIRTUALS_ENTITY_ID             – the agent's entity id (integer)
# Whitelist a signer key on the ACP dashboard and set it here:
# VIRTUALS_AGENT_WALLET_ADDRESS=
# VIRTUALS_ENTITY_ID=
# VIRTUALS_WHITELISTED_WALLET_PRIVATE_KEY=
VIRTUALS_CHAIN_ID=8453
# Optional custom RPC (defaults to BASE_RPC_URL).
# VIRTUALS_RPC_URL=
# Optional third-party evaluator address.
# VIRTUALS_EVALUATOR_ADDRESS=
# Optional: `acp` (the CLI backend, preferred) or `sdk` (Python SDK path).
# Auto-detects — set only if you need to pin one.
# VIRTUALS_BACKEND=

# ---- Dashboard server ----
# HOST=0.0.0.0
# PORT=8000
# Set to 1 for auto-reload during development.
# RELOAD=

# ---- Demo / test-mode toggles (leave off in production) ----
# Seed two demo risk-reviewer workers on startup (used by the test suite).
# PRAETOR_SEED_DEMO_WORKERS=0
# Disable all partner wiring — pure Sibyl-Memory demo (used by the test suite).
# PRAETOR_NO_PARTNERS=0


